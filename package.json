{
  "name": "pdfsandwich",
  "version": "0.2.0",
  "private": true,
  "description": "Windows bilingual PDF reader with synchronized annotations",
  "author": "PDFSandwich contributors",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:python": ".venv\\Scripts\\python.exe -m pytest tests -q",
    "test:ui": "node scripts/smoke.mjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:licenses": ".venv\\Scripts\\python.exe scripts/collect-licenses.py",
    "package": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "io.pdfsandwich.desktop",
    "productName": "PDFSandwich",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/pdfsandwich-worker",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
